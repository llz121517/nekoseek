# 首启播种管理员（一次性，建库后迁移入 DB）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# DeepSeek 平台会话 token（可选，用于平台 usage/cost / 建 key）
DEEPSEEK_PLATFORM_TOKEN=

# DSH 上游地址（webui 监听地址）
DSH_UPSTREAM=http://127.0.0.1:3080
# 托管 dsh 进程的完整启动命令（含参数，如 "dsh web"）
DSH_COMMAND=dsh web
# 网关启动时自动拉起 DSH（1 开启）
DSH_AUTOSTART=0

# DeepSeek LLM 上游（共享 key）
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=

# 配额（token 数，0 表示不限）
POOL_QUOTA_LIMIT=0
DEFAULT_USER_QUOTA=100000
QUOTA_PERIOD=day

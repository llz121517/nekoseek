# ====== 服务 ======
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
# 开发时改为 1 开启热重载（热重载会在单 worker 下运行）
RELOAD=0
LOG_LEVEL=info

# ====== DSH 上游 ======
# DSH webui 监听地址
DSH_UPSTREAM=http://127.0.0.1:3080
# 网关自动拉起 DSH 时使用的完整命令（含参数）
DSH_COMMAND=dsh web
# 是否在网关启动时自动拉起 DSH（1=开）
DSH_AUTOSTART=0
# DSH 工作目录：留空则由 dsh 基于运行账户的 HOME 自建 ~/.dsh（推荐，默认）。
# 仅在需要强制指定位置时填写（会原样透传给 dsh 作为数据根目录）。
# Linux 下若以 root 启动并降权到 DSH_RUN_AS_USER，则无论此项如何，
# 实际目录都为该账户家目录下的 ~/.dsh，与网关自身文件隔离。
DSH_HOME=
# Linux 下运行 DSH 的独立账户（需 root 启动才会降权；Windows 忽略此项）。
# 使用前请先创建：sudo useradd -r -m nekoseek-dsh
DSH_RUN_AS_USER=nekoseek-dsh

# ====== DeepSeek API Key ======
# 拉起 DSH 子进程时通过环境变量临时注入
# DEEPSEEK_API_KEY=sk-...

# ====== 认证 / 账户 ======
# 首次启动且数据库无用户时，使用以下凭据创建初始管理员；账户创建后可移除。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# ====== Session ======
# SESSION_MAX_AGE=604800
# SESSION_SECURE=0

# ====== 服务 ======
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
# 开发时改为 1 开启热重载（热重载会在单 worker 下运行）
RELOAD=0
LOG_LEVEL=info

# ====== DSH 上游 ======
# DSH webui 监听地址
DSH_UPSTREAM=http://127.0.0.1:3080
# 网关自动拉起 DSH 时使用的完整命令（含参数）
DSH_COMMAND=dsh web
# 是否在网关启动时自动拉起 DSH（1=开）
DSH_AUTOSTART=0
# DSH 的独立工作目录（隔离 .env），默认项目根目录下的 ./.dsh
# DSH_HOME=
